# Sentry 错误监控配置
# 复制此文件为 .env.local 或 .env.production 填入实际值

# Sentry DSN (从 https://sentry.io/settings/YOUR_ORG/YOUR_PROJECT/keys/ 获取)
# VITE_SENTRY_DSN=https://your-public-dsn@sentry.io/your-project-id

# 环境标识
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_ENVIRONMENT=staging
# VITE_SENTRY_ENVIRONMENT=production

# 版本号 (用于问题追踪)
# VITE_SENTRY_RELEASE=v1.0.0

# 性能追踪采样率 (0-1, 生产环境建议 0.1-0.2)
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
