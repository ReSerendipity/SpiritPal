#!/bin/sh
# 通用 pre-commit 分发器（无机器特定路径，可随仓库分发）。
#   1) 仓库有 .pre-commit-config.yaml 且 pre-commit 框架可用 -> 交给框架
#   2) 否则 -> 交给同目录的 pre-commit-lite（大文件/密钥/冲突标记 + 根目录守卫）
# 0) 路径可移植性检查：阻止本机绝对路径入库（规则见 docs/CODING_STANDARDS.md 第 1 节）
# 本地层治理文档快照（AGENTS.md + docs/agents/，尽力而为，不阻断提交）
if [ -f "$(dirname "$0")/lib-snapshot.sh" ]; then
    . "$(dirname "$0")/lib-snapshot.sh"
    snapshot_docs
fi
# 0b) 机械守卫：merge 进行中 / 存在未解决冲突 -> 拒绝提交（多代理并发会话须独占 git worktree）
#     刻意置于下方 pre-commit 框架分支「提前 exit 0 / exec」之前——否则装了 .pre-commit-config.yaml
#     就走框架路径提前退出，本守卫会沦为永不执行的「假门禁」。未改动上方尽力而为的快照钩子语义。
UNMERGED="$(git diff --name-only --diff-filter=U 2>/dev/null)"
MERGE_HEAD_PATH="$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)"
IN_MERGE=0
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    IN_MERGE=1
elif [ -n "$MERGE_HEAD_PATH" ] && [ -f "$MERGE_HEAD_PATH" ]; then
    IN_MERGE=1
fi
if [ "$IN_MERGE" -eq 1 ] || [ -n "$UNMERGED" ]; then
    echo "[pre-commit] 检测到 merge 进行中或存在未解决冲突，提交已拒绝。" >&2
    if [ -n "$UNMERGED" ]; then
        echo "[pre-commit] 未合并文件：" >&2
        printf '%s\n' "$UNMERGED" | sed 's/^/    - /' >&2
    fi
    echo "[pre-commit] 多代理并发会话须各自独占 git worktree + 分支，禁止在共享工作树并发 merge/commit（会互相踩踏暂存区与合并态）。" >&2
    echo "[pre-commit] 隔离方法：git worktree add ../<分支名>-wt <分支>（用完 git worktree remove ../<分支名>-wt；详见 AGENTS.md「多代理会话工作树隔离约定」/ docs/agents/SOPS.md SOP-5）" >&2
    echo "[pre-commit] 紧急绕过：git commit --no-verify" >&2
    exit 1
fi
if [ -f scripts/check_no_hardcoded_paths.py ]; then
    PY_BIN=""
    for c in python python3; do
        command -v "$c" >/dev/null 2>&1 && PY_BIN="$c" && break
    done
    if [ -n "$PY_BIN" ]; then
        if ! "$PY_BIN" scripts/check_no_hardcoded_paths.py; then
            echo "[pre-commit] 检测到本机绝对路径（C:\Users\... 等），提交已拒绝。绕过：git commit --no-verify" >&2
            exit 1
        fi
    fi
fi
if [ -f .pre-commit-config.yaml ]; then
    PY=""
    for cand in ".venv/Scripts/python.exe" ".venv/bin/python"; do
        [ -x "$cand" ] && PY="$cand" && break
    done
    if [ -z "$PY" ]; then
        for c in python python3; do
            command -v "$c" >/dev/null 2>&1 && PY="$c" && break
        done
    fi
    if [ -n "$PY" ] && $PY -m pre_commit --version >/dev/null 2>&1; then
        echo "[pre-commit] 使用 pre-commit 框架（.pre-commit-config.yaml）"
        if ! $PY -m pre_commit run --config .pre-commit-config.yaml; then
            echo "[pre-commit] 框架检查未通过。紧急绕过：git commit --no-verify" >&2
            exit 1
        fi
        exit 0
    fi
    # 回退：pre-commit 控制台命令（uv tool / pipx / PATH 安装，无 venv 时保证框架仍生效）
    if command -v pre-commit >/dev/null 2>&1; then
        echo "[pre-commit] 使用 pre-commit 框架（控制台命令）"
        if ! pre-commit run --config .pre-commit-config.yaml; then
            echo "[pre-commit] 框架检查未通过。紧急绕过：git commit --no-verify" >&2
            exit 1
        fi
        exit 0
    fi
fi
exec "$(dirname "$0")/pre-commit-lite"
