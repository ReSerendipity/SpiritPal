#!/bin/sh
# 切换分支后提醒依赖漂移 + 本地层文档快照。$3=1 表示分支检出（0 为单文件检出，跳过）。
[ "$3" = "1" ] || exit 0
. "$(dirname "$0")/lib-depwatch.sh"
depwatch "$1" "$2"
# 本地层治理文档快照（AGENTS.md + docs/agents/，尽力而为，不阻断）
if [ -f "$(dirname "$0")/lib-snapshot.sh" ]; then
    . "$(dirname "$0")/lib-snapshot.sh"
    snapshot_docs
fi
exit 0
