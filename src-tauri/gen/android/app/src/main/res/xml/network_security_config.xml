<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      仅放行本机回环明文流量，用于 companion 模式：
      SpiritPal WebView → MNN Chat 本地 OpenAI 兼容端点 http://127.0.0.1:8080
      （MNN Chat 默认 useHttpsUrl=false，bind 127.0.0.1）。

      作用范围严格限定 127.0.0.1 / localhost，不影响其它域名的明文默认拦截
      （release 构建 manifestPlaceholders usesCleartextTraffic=false 仍对所有非回环域名生效）。

      依据：ADR-0005 #5。此文件位于 gen/android/app/src/main/res/xml/，未被 .gitignore 排除，可入库。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
